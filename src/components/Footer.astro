---
import { SITE_AFFILIATION, SITE_AUTHOR, SITE_CONTACT, url } from '../consts';

const today = new Date();
---

<footer>
	<p class="paws" aria-hidden="true">🐾 🐾 🐾</p>
	<p>&copy; {today.getFullYear()} {SITE_AUTHOR}（{SITE_AFFILIATION}）</p>
	<p>
		連絡先：<a href={`mailto:${SITE_CONTACT}`}>{SITE_CONTACT}</a> ／ <a href={url('rss.xml')}>RSS</a>
	</p>
	<p class="credit">
		このサイトは <a href="https://claude.com/claude-code">Claude Code</a>（Claude Opus 5.5）で作成しました。
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85em;
	}
	footer p {
		margin: 0.3em 0;
	}
	.credit {
		font-size: 0.9em;
	}
	.paws {
		letter-spacing: 0.5em;
	}
</style>
